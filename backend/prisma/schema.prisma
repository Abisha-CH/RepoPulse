// RepoPulse schema — GitHub engineering health dashboard.
// PostgreSQL via env("DATABASE_URL").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  github_id   Int      @unique
  username    String
  email       String?
  // GitHub access token, encrypted at rest (AES-256-GCM). Unencrypted:
  // a hex or base64 blob of IV:authTag:ciphertext produced by src/crypto/token.ts.
  access_token String
  created_at  DateTime @default(now())

  connectedRepos Repo[]

  @@map("users")
}

model Repo {
  id                 String   @id @default(cuid())
  github_repo_id     Int      @unique
  owner              String
  name               String
  connected_by_user_id String
  // GitHub visibility flag. Defaults to TRUE (private) deliberately: rows created
  // before this column existed have no flag, and treating "unknown" as private
  // guarantees a repo never leaks onto the public /leaderboard by default. A
  // connect or sync sets the real value from the GitHub API. Public leaderboard
  // exposes only repos where this is false.
  is_private         Boolean  @default(true)

  connected_by_user User     @relation(fields: [connected_by_user_id], references: [id], onDelete: Cascade)
  pullRequests      PullRequest[]
  insights          Insight[]

  // A repo is unique per (owner, name) — avoid duplicate connections.
  @@unique([owner, name])
  // Fast lookups of all repos a user connected.
  @@index([connected_by_user_id])

  @@map("repos")
}

model Insight {
  id             String   @id @default(cuid())
  repo_id        String
  // Snapshot of the repo's PR count at generation time — used to detect whether
  // the insight is still valid (stale after a new sync changes the PR count).
  pr_snapshot    Int
  generated_at   DateTime @default(now())
  // The full structured JSON result from Gemini (observations array).
  result         Json

  repo Repo @relation(fields: [repo_id], references: [id], onDelete: Cascade)

  @@index([repo_id, generated_at])
  @@map("insights")
}

model PullRequest {
  id             String   @id @default(cuid())
  repo_id        String
  github_pr_id   Int
  author         String
  title          String
  // open | closed | merged
  state          String
  opened_at      DateTime
  first_review_at DateTime?
  merged_at      DateTime?
  closed_at      DateTime?
  // Lines changed on the PR head (additions + deletions) for size bucketing.
  additions      Int      @default(0)
  deletions      Int      @default(0)
  // CI/check status derived from the GitHub Checks API: 'success' | 'failure' | 'pending' | null (unknown / no checks).
  ci_status      String?

  repo       Repo       @relation(fields: [repo_id], references: [id], onDelete: Cascade)
  reviewers  Reviewer[]

  // A GitHub PR is unique within a repo.
  @@unique([repo_id, github_pr_id])
  // Date-range queries are per repo, so lead with repo_id then the date column.
  @@index([repo_id, opened_at])
  @@index([repo_id, first_review_at])
  @@index([repo_id, merged_at])
  @@index([repo_id, closed_at])
  // Cross-repo time-to-merge queries (dashboard-wide): merged_at alone.
  @@index([merged_at])

  @@map("pull_requests")
}

model Reviewer {
  id               String   @id @default(cuid())
  pull_request_id  String
  username         String
  reviewed_at      DateTime

  pull_request PullRequest @relation(fields: [pull_request_id], references: [id], onDelete: Cascade)

  @@index([pull_request_id])
  // Response-time analytics: "how long until reviewer X reviews".
  @@index([username, reviewed_at])

  @@map("reviewers")
}