# Copy this file to .env and fill in real values. NEVER commit .env.

# --- App URL ---
# In local dev with ngrok, set this to your ngrok public URL (e.g. https://xxxx.ngrok-free.app).
# When running pure localhost without ngrok, set to http://localhost:3000.
# GITHUB_REDIRECT_URI automatically uses this base URL if not specified explicitly.
APP_URL=http://localhost:3000

# --- GitHub OAuth (register an OAuth App at https://github.com/settings/developers) ---
# Homepage URL: $APP_URL  /  Authorization callback URL: $APP_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override: defaults to $APP_URL/auth/github/callback
GITHUB_REDIRECT_URI=

# --- Sessions ---
# Any long random string. Used to sign the session JWT. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Token encryption (AES-256-GCM, 32-byte key) ---
# Optional: if unset, derived deterministically from SESSION_SECRET.
# To set explicitly it must be a 64-char hex string (32 bytes):
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Database ---
# Local Postgres or Neon Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/repopulse?schema=public

# --- Slack Digest (optional) ---
# Incoming Webhook URL so the "Send Digest to Slack" button can post the
# team health digest. Get one at https://api.slack.com/messaging/webhooks.
# Leave blank to disable the button (it will error with a clear message).
SLACK_WEBHOOK_URL=

# --- AI Insights (optional) ---
# Google Gemini API key that powers the AI Insights section on the dashboard.
# Get one at https://aistudio.google.com/apikey. Leave blank to disable the
# section (the UI will show a clear "not configured" message).
GEMINI_API_KEY=

# --- Server Config ---
PORT=3000
# Optional: destination after login. Default '/' keeps the user on the current host.
FRONTEND_ORIGIN=/