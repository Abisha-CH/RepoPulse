# Copy this file to .env and fill in real values. NEVER commit .env.
# --- GitHub OAuth (register an OAuth App at https://github.com/settings/developers) ---
# Homepage URL: http://localhost:3000  /  Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fully-qualified path to callback URL. Defaults to http://localhost:3000/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# --- Sessions ---
# Any long random string. Used to sign the session JWT. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Token encryption (AES-256-GCM, 32-byte key) ---
# Optional: if unset, derived deterministically from SESSION_SECRET.
# To set explicitly it must be a 64-char hex string (32 bytes):
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/repopulse?schema=public

# --- App ---
PORT=3000
# Single-origin: the built frontend is served by the backend. In development you
# can run Vite on :5173 (proxy) and login then redirects here for HMR:
FRONTEND_ORIGIN=http://localhost:5173